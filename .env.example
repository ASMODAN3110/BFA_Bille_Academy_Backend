# BFA Bille Football Academy — modèle de variables d'environnement
# Copier ce fichier vers `.env` et renseigner les valeurs réelles.
# Ne JAMAIS committer `.env` (il contient des secrets).

# Connexion PostgreSQL classique (locale).
DATABASE_URL="postgresql://postgres:CHANGER_MDP@localhost:5432/bfa_bille_academy?schema=public"

# Serveur Express
# Note : le port 3000 peut être occupé par d'autres applications (ex : Docker/WSL) — choisir un port libre.
PORT=4000

# Authentification JWT (back-office)
# `JWT_SECRET` : clé de signature des tokens — générer une chaîne aléatoire longue (≥ 32 caractères).
# `JWT_EXPIRES_IN` : durée de validité (formats jsonwebtoken : "7d", "1h", etc.).
JWT_SECRET=change_me_in_production_avec_une_chaine_aleatoire_longue
JWT_EXPIRES_IN=7d

# Optionnel : "1" pour tracer les requêtes SQL Prisma dans les logs.
LOG_QUERIES=0

# MinIO / S3 (stockage des médias)
# `S3_ENDPOINT` : point d'accès pour les scripts lancés sur le HOST. Depuis le conteneur
#                 backend, docker-compose surcharge cette valeur par `http://minio:9000`.
# `S3_PUBLIC_URL` : ORIGINE des URLs publiques (schéma + hôte + port, sans le bucket) —
#                 le nom du bucket est ajouté par `getFileUrl` (`/bfa-media/<clé>`, path-style MinIO).
# `S3_ACCESS_KEY` / `S3_SECRET_KEY` : identifiants root MinIO (= MINIO_ROOT_USER/PASSWORD).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bfa-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGER_MDP_MINIO

# Emails Module 3 — optionnel : EMAIL_ENABLED=1 + SMTP pour un envoi réel.
# Sans SMTP (ou EMAIL_ENABLED absent), les emails sont loggés en console (mode dev).
EMAIL_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@bfa-academy.com
SMTP_PASS=CHANGER_MDP_SMTP
SMTP_FROM=BFA Bille Football Academy <no-reply@bfa-academy.com>
