# BFA Bille Football Academy — modèle de variables d'environnement
# Copier ce fichier vers `.env` et renseigner les valeurs réelles.
# Ne JAMAIS committer `.env` (il contient des secrets).

# Connexion PostgreSQL classique (locale).
DATABASE_URL="postgresql://postgres:CHANGER_MDP@localhost:5432/bfa_bille_academy?schema=public"

# Serveur Express
# Note : le port 3000 peut être occupé par d'autres applications (ex : Docker/WSL) — choisir un port libre.
PORT=4000

# Authentification JWT (back-office)
# `JWT_SECRET` : clé de signature des tokens — générer une chaîne aléatoire longue (≥ 32 caractères).
# `JWT_EXPIRES_IN` : durée de validité (formats jsonwebtoken : "7d", "1h", etc.).
JWT_SECRET=change_me_in_production_avec_une_chaine_aleatoire_longue
JWT_EXPIRES_IN=7d

# Optionnel : "1" pour tracer les requêtes SQL Prisma dans les logs.
LOG_QUERIES=0
